# Copia a `.env` y rellena. NUNCA commitees el .env real.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# URLs públicas: la del web va en los correos; la del API, en las URLs de archivos.
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000/api

# ─── Sesiones ─────────────────────────────────────────────────────────────
# Secreto con el que el API firma los JWT. Mínimo 32 caracteres:
#   openssl rand -base64 48
JWT_SECRET=

# ─── Postgres (Railway) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ─── Almacenamiento: Railway Bucket (S3-compatible) ───────────────────────
# railway bucket credentials -b <bucket> --json
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Correo (Brevo u otro SMTP). Sin esto los enlaces solo salen en el log ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=El Camino Angosto <no-reply@elcaminoangosto.app>

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
